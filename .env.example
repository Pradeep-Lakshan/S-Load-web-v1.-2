# Application Environment Configuration
# Copy this file to .env for local production or development

# Server Configuration
PORT=3000
HOST="0.0.0.0"

# Backend FastAPI URL (if running standalone python backend service)
# In Docker Compose, this connects to http://backend:8000
BACKEND_URL="http://localhost:8000"

# Security & Constraints
MAX_DURATION_SECONDS=1800 # 30 minutes max
MAX_FILESIZE_MB=500       # 500 MB max stream size
RATE_LIMIT_PER_MIN=10     # Max requests per IP per minute

# Cloudflare Turnstile Captcha (Optional: set dummy or real keys)
# For demo/test mode, use Cloudflare's always-pass test sitekey: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
ENABLE_CAPTCHA=false

# Allowed Origins (CORS)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Temporary Storage Directory (auto-cleaned)
TEMP_DIR="/tmp/vortxfetch_media"

# App Hosting URL
APP_URL="http://localhost:3000"
